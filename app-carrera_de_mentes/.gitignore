.classpath
.project
.settings/
.metadata/
bin/
tmp/
*.tmp
*.bak
*.swp
*~.nib
local.properties
.loadpath
.factorypath

# ===================================================================
# VS Code / Antigravity IDE
# ===================================================================
.vscode/
*.code-workspace
.history/
.factorypath
.apt_generated/
.gemini/

# ===================================================================
# Vim / Neovim / LazyVim
# ===================================================================
# Archivos swap, backup y undo de Vim
*.swp
*.swo
*.swn
*~
*.un~
.netrwhist
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-z]


# Sesiones de Vim / LazyVim
Session.vim
Sessionx.vim

# Directorios de caché y workspace de jdtls / lsp para Neovim
.jdtls/
.nvim/

